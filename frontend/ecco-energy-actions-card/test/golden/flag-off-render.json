{
 "side-by-side-idle": "\n      <ha-card>\n        <h1 class=\"card-title\">Energy Actions</h1>\n        <div class=\"actions-grid\">\n          \n      <div class=\"tile free-power-tile state-ready\">\n        <div class=\"tile-header\">\n          <div class=\"tile-heading\">\n            <ha-icon class=\"tile-icon\" icon=mdi:flash-outline></ha-icon>\n            <span class=\"tile-name\">Free Power</span>\n          </div>\n          <span class=\"state-pill state-ready\">Ready</span>\n        </div>\n\n        <div class=\"free-power-body\">\n          \n          \n\n          \n      \n      <div class=\"mode-selector\" role=\"tablist\">\n        <button\n          type=\"button\"\n          role=\"tab\"\n          class=\"mode-tab is-active\"\n          aria-selected=\n          @click=[fn]\n        >\n          <ha-icon icon=\"mdi:flash\"></ha-icon> Now\n        </button>\n        <button\n          type=\"button\"\n          role=\"tab\"\n          class=\"mode-tab \"\n          aria-selected=\n          @click=[fn]\n        >\n          <ha-icon icon=\"mdi:calendar-clock\"></ha-icon> Later\n        </button>\n      </div>\n    \n      \n      <p class=\"tile-description\">Charge the battery from free/zero-cost grid energy.</p>\n\n      \n      <div class=\"number-control\">\n        <div class=\"number-control-label\">\n          <ha-icon icon=mdi:flash></ha-icon>\n          <span>Max Charge Power</span>\n          <span class=\"number-control-value\">5.00 kW</span>\n        </div>\n        <input\n          type=\"range\"\n          class=\"number-control-slider\"\n          style=\"--eaa-slider-fill:60%\"\n          min=500\n          max=8000\n          step=100\n          .value=5000\n          ?disabled=\n          @input=[fn]\n          @change=[fn]\n        />\n      </div>\n    \n      \n      <div class=\"number-control\">\n        <div class=\"number-control-label\">\n          <ha-icon icon=mdi:timer-outline></ha-icon>\n          <span>Duration</span>\n          <span class=\"number-control-value\">1h</span>\n        </div>\n        <input\n          type=\"range\"\n          class=\"number-control-slider\"\n          style=\"--eaa-slider-fill:24.686192468619247%\"\n          min=1\n          max=240\n          step=1\n          .value=60\n          ?disabled=\n          @input=[fn]\n          @change=[fn]\n        />\n      </div>\n    \n\n      <div class=\"readiness-row\">\n        <ha-icon icon=mdi:shield-outline></ha-icon>\n        <span>Safe - no inverter change made by staging values</span>\n      </div>\n      \n      <p\n        class=\"firmware-note clickable\"\n        tabindex=\"0\"\n        role=\"button\"\n        @click=[fn]\n        @keydown=[fn]\n      >\n        Idle\n      </p>\n    \n\n      <div class=\"action-row\">\n        <button\n          class=\"arm-toggle \"\n          ?disabled=\n          @click=[fn]\n        >\n          <ha-icon icon=mdi:shield-key-outline></ha-icon>\n          Arm Free Power\n        </button>\n        <button\n          class=\"start-button\"\n          ?disabled=\n          @click=[fn]\n        >\n          <ha-icon icon=\"mdi:play-circle-outline\"></ha-icon>\n          Start Now\n        </button>\n      </div>\n      <p class=\"arm-caption\">Arm is single-use - it's consumed the moment you press Start, or if the attempt is rejected.</p>\n    \n    \n        </div>\n      </div>\n    \n          \n      <div class=\"tile dump-to-grid-tile state-ready\">\n        <div class=\"tile-header\">\n          <div class=\"tile-heading\">\n            <ha-icon class=\"tile-icon\" icon=mdi:transmission-tower-export></ha-icon>\n            <span class=\"tile-name\">Dump to Grid</span>\n          </div>\n          <span class=\"state-pill state-ready\">Ready</span>\n        </div>\n\n        <div class=\"dump-to-grid-body\">\n          \n          \n\n          \n      \n      <div class=\"mode-selector\" role=\"tablist\">\n        <button\n          type=\"button\"\n          role=\"tab\"\n          class=\"mode-tab is-active\"\n          aria-selected=\n          @click=[fn]\n        >\n          <ha-icon icon=\"mdi:flash\"></ha-icon> Now\n        </button>\n        <button\n          type=\"button\"\n          role=\"tab\"\n          class=\"mode-tab \"\n          aria-selected=\n          @click=[fn]\n        >\n          <ha-icon icon=\"mdi:calendar-clock\"></ha-icon> Later\n        </button>\n      </div>\n    \n      \n      <p class=\"tile-description\">Export stored battery energy to the grid down to a chosen floor.</p>\n\n      \n      <div class=\"number-control\">\n        <div class=\"number-control-label\">\n          <ha-icon icon=mdi:transmission-tower-export></ha-icon>\n          <span>Export Power</span>\n          <span class=\"number-control-value\">2.50 kW</span>\n        </div>\n        <input\n          type=\"range\"\n          class=\"number-control-slider\"\n          style=\"--eaa-slider-fill:26.666666666666668%\"\n          min=500\n          max=8000\n          step=100\n          .value=2500\n          ?disabled=\n          @input=[fn]\n          @change=[fn]\n        />\n      </div>\n    \n      \n      <div class=\"number-control\">\n        <div class=\"number-control-label\">\n          <ha-icon icon=mdi:battery-arrow-down></ha-icon>\n          <span>Stop SOC</span>\n          <span class=\"number-control-value\">30%</span>\n        </div>\n        <input\n          type=\"range\"\n          class=\"number-control-slider\"\n          style=\"--eaa-slider-fill:25%\"\n          min=10\n          max=90\n          step=1\n          .value=30\n          ?disabled=\n          @input=[fn]\n          @change=[fn]\n        />\n      </div>\n    \n      \n      <div class=\"number-control\">\n        <div class=\"number-control-label\">\n          <ha-icon icon=mdi:timer-outline></ha-icon>\n          <span>Duration</span>\n          <span class=\"number-control-value\">45 min</span>\n        </div>\n        <input\n          type=\"range\"\n          class=\"number-control-slider\"\n          style=\"--eaa-slider-fill:18.410041841004183%\"\n          min=1\n          max=240\n          step=1\n          .value=45\n          ?disabled=\n          @input=[fn]\n          @change=[fn]\n        />\n      </div>\n    \n\n      <div class=\"readiness-row\">\n        <ha-icon icon=mdi:shield-outline></ha-icon>\n        <span>Safe - no inverter change made by staging values</span>\n      </div>\n      \n      <p\n        class=\"firmware-note clickable\"\n        tabindex=\"0\"\n        role=\"button\"\n        @click=[fn]\n        @keydown=[fn]\n      >\n        Idle\n      </p>\n    \n\n      <div class=\"action-row\">\n        <button\n          class=\"arm-toggle \"\n          ?disabled=\n          @click=[fn]\n        >\n          <ha-icon icon=mdi:shield-key-outline></ha-icon>\n          Arm Dump to Grid\n        </button>\n        <button\n          class=\"start-button\"\n          ?disabled=\n          @click=[fn]\n        >\n          <ha-icon icon=\"mdi:play-circle-outline\"></ha-icon>\n          Start Now\n        </button>\n      </div>\n      <p class=\"arm-caption\">Arm is single-use - it's consumed the moment you press Start, or if the attempt is rejected.</p>\n    \n      \n    \n        </div>\n      </div>\n    \n        </div>\n      </ha-card>\n    ",
