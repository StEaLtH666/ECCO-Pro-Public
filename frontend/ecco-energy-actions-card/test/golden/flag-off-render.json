\n      </div>\n      <p class=\"arm-caption\">Arm is single-use - it's consumed the moment you press Start, or if the attempt is rejected.</p>\n    \n    \n        </div>\n      </div>\n    \n          \n      <div class=\"tile dump-to-grid-tile state-active\">\n        <div class=\"tile-header\">\n          <div class=\"tile-heading\">\n            <ha-icon class=\"tile-icon\" icon=mdi:transmission-tower-export></ha-icon>\n            <span class=\"tile-name\">Dump to Grid</span>\n          </div>\n          <span class=\"state-pill state-active\">Active</span>\n        </div>\n\n        <div class=\"dump-to-grid-body\">\n          \n          \n\n          \n      <div class=\"active-hero\">\n        <div class=\"active-hero-time\">9h 27m</div>\n        <div class=\"active-hero-label\">time remaining</div>\n      </div>\n      <div class=\"active-secondary-line\">\n        Target -- export • ends 18:30\n      </div>\n      <div class=\"active-secondary-line\">\n        Battery: 64% • stops at --\n      </div>\n\n      <div class=\"readiness-row\">\n        <ha-icon icon=mdi:content-save-alert-outline></ha-icon>\n        <span>No snapshot recorded - check status</span>\n      </div>\n\n      \n      <p\n        class=\"firmware-note clickable\"\n        tabindex=\"0\"\n        role=\"button\"\n        @click=[fn]\n        @keydown=[fn]\n      >\n        Active\n      </p>\n    \n      \n      \n      <button\n        class=\"end-restore-button \"\n        ?disabled=\n        @click=[fn]\n      >\n        <ha-icon icon=\"mdi:backup-restore\"></ha-icon>\n        End & Restore Now\n        \n      </button>\n    \n    \n        </div>\n      </div>\n    \n        </div>\n      </ha-card>\n    ",
