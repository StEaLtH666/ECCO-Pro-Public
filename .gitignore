# Secrets and credentials (firmware/secrets.yaml.example is the tracked template)
secrets.yaml
**/secrets.yaml
.env
.env.*
*.key
*.pem
*.p12
*.pfx

# Home Assistant secrets / databases
home-assistant_v2.db*
*.db-shm
*.db-wal

# ESPHome build/runtime output
.esphome/
**/.esphome/
.pioenvs/
.piolibdeps/
.platformio/

# Local configuration containing private values
ecco_site.local.yaml
**/ecco_site.local.yaml
config.local.yaml
**/config.local.yaml
*_private.yaml
**/*_private.yaml
intelligence/profiles/*.local.json
hist_*.csv*
quality_report_data.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary / backup files
*.bak
*.tmp
*.swp
*~

# Logs
*.log

# Flight recorder captures (local observation data, not repo content)
tools/flight-recordings/

# Python
__pycache__/
*.pyc

# Node (frontend card builds)
node_modules/

# Local build output: tools/build_ha_bundle.py writes a REVIEW-ONLY bundle and tools/ecco_site_render.py writes the site render
# (dist/site/, contains site values) here
dist/
!frontend/**/dist/
