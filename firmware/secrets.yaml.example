# ESPHome secrets template for the ECCO firmware. Copy this file to firmware/secrets.yaml (git-ignored) and replace every
# value with your own. Never commit secrets.yaml, and never paste its contents into an issue or pull request.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"
# ESPHome native API encryption key: 32 random bytes, base64-encoded (for example from the ESPHome dashboard's
# "Generate" button, or: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())").
ecco_api_key: "replace-with-your-base64-api-encryption-key"
ecco_ota_password: "replace-with-your-ota-password"
